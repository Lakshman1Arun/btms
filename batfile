fi
say "Payload integrity OK (sha256)."

mkdir -p "$T"
tar xzf "$TMP/blob.tar.gz" -C "$T"
NF="$(tar tzf "$TMP/blob.tar.gz" | grep -v '/$' | wc -l | tr -d ' ')"
