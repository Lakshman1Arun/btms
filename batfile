set -euo pipefail

say()  { printf '\033[1;36m[btms]\033[0m %s\n' "$1"; }
fail() { printf '\033[1;31m[btms]\033[0m %s\n' "$1" >&2; exit 1; }

if printf 'aGk=\n' | base64 -d >/dev/null 2>&1; then B64="base64 -d"; else B64="base64 -D"; fi
sha() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

command -v tar    >/dev/null 2>&1 || fail "tar not found"
command -v base64 >/dev/null 2>&1 || fail "base64 not found"

case "${1:-}" in
  -h|--help) grep -E '^#  ' "$0" | sed 's/^#  //'; exit 0 ;;
esac

DEST="${1:-.}"
mkdir -p "$DEST"
T="$DEST/btms_simulation"
if [ -e "$T" ]; then
  fail "target exists: $T (remove it or pass a different directory)"
fi

